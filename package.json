{
  "name": "saheli-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SAHELI — Smart Women Safety & Emergency Assistance Platform (Monorepo)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "nodemailer": "^10.3.1"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend",
    "frontend:lint": "npm run lint --workspace=frontend",
    "backend:start": "npm run start --workspace=backend",
    "backend:test": "npm run test --workspace=backend",
    "db:backup": "npm run backup --workspace=backend",
    "test": "npm run test --workspace=backend"
  }
}
